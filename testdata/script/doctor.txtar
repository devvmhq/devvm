# doctor: what Lima needs on this machine and how to get what's missing,
# the features Lima gives VMs, and whether Docker is there. --json prints
# what it found as JSON, for scripts, and nothing else.
env ALL=$PATH
chmod 0755 brew/brew
chmod 0755 broken/limactl
chmod 0755 qemu/qemu-system-aarch64
chmod 0755 qemu/qemu-system-x86_64
chmod 0755 qemu/qemu-img
# On Linux, devvm-immutable: the stub, which works.
[linux] env DEVVM_IMMUTABLE_HELPER=$IMMUTABLE_STUB

# Everything there: only limactl --version runs (and on Linux,
# devvm-immutable's check).
exec devvm doctor
[linux] stdout '^doctor_immutable_ok\n'
[darwin] ! stdout doctor_immutable
stdout '^FEATURE +SUPPORT\n'
stdout '^build-image +native\n'
stdout '^egress-proxy +native\n'
stdout '^ports +emulated\n'
stdout '^ports-all +emulated\n'
stdout '^agent-toggle +native\n'
stdout '^disk +native\n'
stdout '^docker-layer +native\n'
stdout '^docker_found\n'
stdout '^doctor_ok backend=lima version=\S+\n\z'
! stderr .
stub_calls
[darwin] stdout '^limactl --version\n\z'
[linux] stdout '^limactl --version\ndevvm-immutable check\n\z'
exec devvm doctor --json
stdout '^{\n  "version": 1,\n  "backend": "lima",\n  "problems": \[\],\n  "warnings": \[\],\n  "docker": true,\n  "git_lock": true,\n'
stdout '^      "ports": "emulated",$'
! stderr .

# On Linux, a devvm-immutable that's missing or doesn't work is a warning,
# saying why, with how to install it, and doctor still passes: this devvm
# came without one.
[linux] env DEVVM_IMMUTABLE_HELPER=$WORK/none/devvm-immutable
[linux] exec devvm doctor
[linux] stderr '^devvm: doctor_immutable_missing$'
[linux] stdout '^doctor_immutable_no_source\n'
[linux] stdout '^doctor_ok '
[linux] exec devvm doctor --json
[linux] stdout '^  "warnings": \[\n    "doctor_immutable_missing"\n  \],\n  "docker": true,\n  "git_lock": false,$'
[linux] env DEVVM_IMMUTABLE_HELPER=$IMMUTABLE_STUB
[linux] exec sh -c ': > "$STUB_DIR/immutable-no-cap"'
[linux] exec devvm doctor
[linux] stderr '^devvm: doctor_immutable_unusable reason=it doesn''t hold CAP_LINUX_IMMUTABLE$'
[linux] stdout '^doctor_ok '
[linux] rm $STUB_DIR/immutable-no-cap

# What in the VMs' folder isn't a VM's, warned about and left as it is:
# a file, a folder that isn't named by a hash, and a VM's folder without
# vm.json, as a devvm that stopped part way leaves.
mkdir $VMS/devvm-old $VMS/0123456789abcd
cp default.yaml $VMS/notes.txt
cp default.yaml $VMS/0123456789abcd/lock
exec devvm doctor
stderr '^devvm: vm_folder_stateless path=\S+/vms/0123456789abcd$'
stderr '^devvm: vms_stray path=\S+/vms/devvm-old vms=\S+/vms$'
stderr '^devvm: vms_stray path=\S+/vms/notes.txt vms=\S+/vms$'
stdout '^doctor_ok '
exec devvm doctor --json
stdout '^  "warnings": \[\n    "vm_folder_stateless path=\S+/vms/0123456789abcd",\n    "vms_stray path=\S+/vms/devvm-old vms=\S+/vms",\n    "vms_stray path=\S+/vms/notes.txt vms=\S+/vms"\n  \],$'
exists $VMS/devvm-old $VMS/notes.txt $VMS/0123456789abcd/lock
rm $VMS

# No flag or file chooses the backend.
! exec devvm doctor --backend lima
stderr '^devvm: flag_unknown command=devvm doctor flag=--backend$'
! stdout .

# No Lima, no Homebrew, no Docker: what to install, and it fails.
# QEMU's there, which only Linux checks.
env PATH=$WORK/qemu${:}$DEVVM_BIN
! exec devvm doctor
stdout '^FEATURE +SUPPORT\n'
stdout '^docker_missing\n'
! stdout doctor_ok
stderr '^devvm: program_missing name=Lima program=limactl$'
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": null,\n      "message": "program_missing name=Lima program=limactl"\n'
stdout '^  "docker": false,$'
! stderr .

# Every command that needs the backend stops at the first problem.
! exec devvm build base
stderr '^devvm: program_missing name=Lima program=limactl$'
mkdir p
cd p
! exec devvm --network open
stderr '^devvm: program_missing name=Lima program=limactl$'
cd ..

# With Homebrew, its command.
env PATH=$WORK/brew${:}$WORK/qemu${:}$DEVVM_BIN
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": "brew install lima",\n      "message": "program_missing_fix fix=brew install lima name=Lima program=limactl"\n'

# A limactl that doesn't run, as one built for another processor.
env PATH=$WORK/broken${:}$WORK/brew${:}$WORK/qemu${:}$DEVVM_BIN
exec devvm doctor --json
stdout '^      "key": "lima",\n      "fix": "brew reinstall lima",\n      "message": "program_broken_fix command=limactl --version fix=brew reinstall lima name=Lima"\n'
! exec devvm doctor
stderr '^devvm: program_broken_fix command=limactl --version fix=brew reinstall lima name=Lima$'

# One of Lima's global configs in devvm's Lima home, listed after the
# rest.
mkdir $DEVVM_LIMA_HOME/_config
cp default.yaml $DEVVM_LIMA_HOME/_config/default.yaml
! exec devvm doctor
stderr '^devvm: program_broken_fix command=limactl --version fix=brew reinstall lima name=Lima\ndevvm: lima_global_config files=\S+/_config/default.yaml\n\z'
env PATH=$ALL
! exec devvm doctor
stderr '^devvm: lima_global_config files=\S+/_config/default.yaml$'
exec devvm doctor --json
stdout '^  "problems": \[\n    {\n      "key": "lima-config",\n      "fix": null,\n      "message": "lima_global_config files=\S+/_config/default.yaml"\n    }\n  \],$'

-- brew/brew --
#!/bin/sh
-- broken/limactl --
#!/bin/sh
exit 126
-- qemu/qemu-system-aarch64 --
#!/bin/sh
-- qemu/qemu-system-x86_64 --
#!/bin/sh
-- qemu/qemu-img --
#!/bin/sh
-- default.yaml --
networks: [{vzNAT: true}]
