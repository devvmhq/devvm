-- deps-none.want --
==> everything devvm needs is installed
checked
-- ran-fixes.want --
sudo apt-get install -y qemu-system-arm
brew install lima
-- ran-kvm.want --
sudo usermod -aG kvm me
-- main.sh --
. "$WORK/lib.sh"
release 0.1.0
main "$@"
-- prerelease.sh --
# main.sh with a release, 0.1.0, the latest, and a prerelease,
# 0.2.0-rc.1, whose SHA256SUMS.minisig reads $SIG (default: good), for a
# script that trusts RWTESTKEY.
. "$WORK/lib.sh"
release 0.1.0
release 0.2.0-rc.1
echo "good RWTESTKEY" > "$WORK/repo/releases/download/v0.1.0/SHA256SUMS.minisig"
echo "${SIG:-good RWTESTKEY}" > "$WORK/repo/releases/download/v0.2.0-rc.1/SHA256SUMS.minisig"
minisign_key=RWTESTKEY
latest_release() { echo 0.1.0; }
main "$@"
echo "runs $("$prefix/bin/devvm")"
-- nobrew.sh --
# main.sh without a brew on PATH.
. "$WORK/lib.sh"
release 0.1.0
command() { if [[ $1 == -v && $2 == brew ]]; then return 1; fi; builtin command "$@"; }
main "$@"
-- real.sh --
# The devvm the tests built, alone, as a release.
. "$WORK/lib.sh"
n=devvm-1.2.3-$(platform)
d=$WORK/repo/releases/download/v1.2.3
mkdir -p "$d" "$WORK/build"
cp -R "$DEVVM_BIN" "$WORK/build/$n"
tar -czf "$d/$n.tar.gz" -C "$WORK/build" "$n"
echo "$(sha256 "$d/$n.tar.gz")  $n.tar.gz" > "$d/SHA256SUMS"
install_devvm 1.2.3 >/dev/null 2>&1
cd "$WORK"
"$prefix/bin/devvm" __complete setup --features ''
install_deps "$prefix/lib/devvm/1.2.3/devvm"
-- bin/minisign --
#!/bin/bash
# Stand-in for minisign: a signature file reading "good KEY" verifies
# with -P KEY.
while (($#)); do case $1 in -x) sig=$2; shift ;; -P) key=$2; shift ;; esac; shift; done
[[ "$(cat "$sig")" == "good $key" ]]
-- bin/brew --
#!/bin/sh
# Stand-in for Homebrew: every command logs to $WORK/ran. Its Cellar is
# $WORK/Cellar, so a devvm keg is a folder in $WORK/Cellar/devvm.
echo "brew $*" >> "$WORK/ran"
-- bin/sudo --
#!/bin/sh
echo "sudo $*" >> "$WORK/ran"
