# devvm agent login: an agent's login in the folder's VM, launched as
# devvm host does, saved in devvm's store by the VM's proxy; or an API key
# saved in the store from here, the running VM given its copy of the login
# with placeholders and its proxy the binding at once. A login that saves
# nothing fails, and so does one whose agent fails. (The browser login's
# forward of localhost:1455 is tested in internal/vmssh and end to end.)

# Usage errors, before anything runs.
! exec devvm agent login
stderr '^devvm: arg_missing args=AGENT command=devvm agent login$'
! exec devvm agent login aider
stderr '^devvm: arg_not_choice choices=claude, codex, opencode, pi(, [a-z0-9-]+)* command=devvm agent login given=aider$'
! exec devvm agent login codex --setup-token
stderr '^devvm: agent_login_setup_token_alone$'
! exec devvm agent login claude --device-code
stderr '^devvm: agent_login_claude_flag flag=--device-code$'
! exec devvm agent login claude --api-key
stderr '^devvm: agent_login_claude_flag flag=--api-key$'
! exec devvm agent login claude --stdin
stderr '^devvm: agent_login_claude_flag flag=--stdin$'
! exec devvm agent login codex --stdin
stderr '^devvm: agent_login_stdin_alone agent=codex$'
! exec devvm agent login codex --api-key --provider anthropic
stderr '^devvm: agent_login_provider_alone agents=opencode, pi(, [a-z0-9-]+)*$'
! exec devvm agent login opencode --provider anthropic
stderr '^devvm: agent_login_provider_alone agents=opencode, pi(, [a-z0-9-]+)*$'
! exec devvm agent login opencode --api-key
stderr '^devvm: agent_login_provider_needed agent=opencode providers=anthropic, openai, openrouter$'
! exec devvm agent login opencode --api-key --provider groq
stderr '^devvm: arg_not_choice choices=anthropic, openai, openrouter command=--provider given=groq$'
! exec devvm agent login codex --api-key --device-code
stderr '^devvm: flags_exclusive'
# pi: an API key alone, for a provider of the three.
! exec devvm agent login pi
stderr '^devvm: agent_login_key_only agent=pi$'
! exec devvm agent login pi --device-code
stderr '^devvm: agent_login_key_only agent=pi$'
! exec devvm agent login pi --provider openai
stderr '^devvm: agent_login_key_only agent=pi$'
! exec devvm agent login pi --api-key
stderr '^devvm: agent_login_provider_needed agent=pi providers=anthropic, openai, openrouter$'
! exec devvm agent login pi --api-key --provider groq
stderr '^devvm: arg_not_choice choices=anthropic, openai, openrouter command=--provider given=groq$'

# No VM.
project none
! exec devvm agent login codex --device-code
stderr '^devvm: no_vm dir=\S*/none$'

# A VM without the agent.
project plain
exec devvm --network open --no-git-protect --agents none
! exec devvm agent login codex --device-code
stderr '^devvm: agent_login_no_agent agent=codex vm=devvm-plain-[0-9a-f]{14}$'

# A VM with Codex and opencode: Codex's device-code login runs in it, its
# login kept in its file; the stub saves no login, so devvm says so.
project agents
exec devvm --network open --no-git-protect --agents codex,opencode
vm_name AG agents
stub_reset
! exec devvm agent login codex --device-code
stderr '^devvm: agent_login_not_saved agent=codex vm=devvm-agents-[0-9a-f]{14}$'
stub_calls
stdout '''bash'' ''-lc'' ''[^'']*devvm-login\.pid" && exec "\$@"'' ''devvm'' ''codex'' ''-c'' ''cli_auth_credentials_store="file"'' ''login'' ''--device-auth''$'
! stdout ssh
stub_reset
! exec devvm agent login opencode --device-code
stderr '^devvm: agent_login_not_saved agent=opencode vm=devvm-agents-[0-9a-f]{14}$'
stub_calls
stdout '''opencode'' ''auth'' ''login'' ''openai'' ''--method'' ''chatgpt-headless''$'

# In a browser: localhost:1455 is forwarded to the VM while the login
# runs, and not afterwards.
stub_reset
! exec devvm agent login codex
stdout '^==> agent_login_forward agent=codex port=1455 vm=devvm-agents-[0-9a-f]{14}$'
stderr '^devvm: agent_login_not_saved agent=codex vm=devvm-agents-[0-9a-f]{14}$'
stub_calls
stdout '''codex'' ''-c'' ''cli_auth_credentials_store="file"'' ''login''$'
! exec nc -z 127.0.0.1 1455

# The agent's login fails: said, nothing more.
exec sh -c 'echo "''--device-auth''" > "$STUB_DIR/shell-fails-on"'
! exec devvm agent login codex --device-code
stderr '^devvm: agent_login_exited agent=codex vm=devvm-agents-[0-9a-f]{14}$'
rm $STUB_DIR/shell-fails-on

# An API key, read from a line: the store keeps it, only yours to read,
# the VM gets its copy of the login, and its proxy the binding at once.
stub_reset
stdin $WORK/key
exec devvm agent login codex --api-key --stdin
stdout '^==> agent_key_saved agent=codex provider=openai vm=devvm-agents-[0-9a-f]{14}$'
grep '"OPENAI_API_KEY": "sk-testfake-codex"' $DATA/logins/codex/.codex/auth.json
grep '"auth_mode": "apikey"' $DATA/logins/codex/.codex/auth.json
[!darwin] exec sh -c 'stat -c %a "$DATA/logins/codex/.codex/auth.json"'
[darwin] exec sh -c 'stat -f %Lp "$DATA/logins/codex/.codex/auth.json"'
stdout '^600$'
grep '"name":"codex-key"' $AG_dir/run/secrets.json
stub_calls
stdout '''sh'' ''-c'' ''f="\$HOME/\$1".*'' ''sh'' ''.codex/auth.json''$'
! stdout 'sk-testfake'

# opencode's key for a provider: the store keeps it beside the others,
# and the VM's opencode, once it has its database, imports the store's
# opencode logins with devvm's guest script (opencode.sh), their
# placeholders on its input.
stub_reset
stdin $WORK/key2
exec devvm agent login opencode --api-key --provider anthropic --stdin
stdout '^==> agent_key_saved agent=opencode provider=anthropic vm=devvm-agents-[0-9a-f]{14}$'
grep '"key": "sk-ant-testfake"' $DATA/logins/opencode/.local/share/opencode/auth.json
grep '"name":"opencode-anthropic"' $AG_dir/run/secrets.json
stub_calls
stdout '''sh'' ''-c'' ''f="\$HOME/\$1".*'' ''sh'' ''.local/share/opencode/auth.json''$'
stdout '''bash'' ''-lc'' ''#!/bin/bash$'
stdout 'if ! opencode auth import <<<"\[\$entry\]" >&2; then$'
stdout '^'' ''opencode\.sh''$'
! stdout 'sk-ant-testfake'

# Every launch sends the store's opencode logins as opencode 2's import
# reads them, devvm's IDs and placeholders alone, beside the script.
stub_reset
exec devvm host
exec tar -tf $STUB_DIR/sync.tar
stdout '^opencode\.sh$'
exec tar -xOf $STUB_DIR/sync.tar opencode-import.json
stdout '\{"active":true,"id":"cred_devvm_anthropic","integrationID":"anthropic","label":"devvm","value":\{"key":"devvm-proxy-managed-opencode-anthropic[^"]*","type":"key"\}'
! stdout 'sk-ant-testfake'

# opencode refuses a provider's entry: devvm names the provider.
exec sh -c 'echo openrouter > "$STUB_DIR/opencode-refuses"'
stdin $WORK/key2
! exec devvm agent login opencode --api-key --provider anthropic --stdin
stderr '^devvm: opencode_import_failed providers=openrouter vm=devvm-agents-[0-9a-f]{14}$'
rm $STUB_DIR/opencode-refuses

# The import prints without end: devvm stops it at its cap and says so.
exec sh -c ': > "$STUB_DIR/opencode-floods"'
stdin $WORK/key2
! exec devvm agent login opencode --api-key --provider anthropic --stdin
stderr '^devvm: opencode_import_too_much vm=devvm-agents-[0-9a-f]{14}$'
rm $STUB_DIR/opencode-floods

# The import fails: the key is saved, and devvm says the VM's copy failed.
exec sh -c 'echo "opencode auth import" > "$STUB_DIR/shell-fails-on"'
stdin $WORK/key2
! exec devvm agent login opencode --api-key --provider anthropic --stdin
stderr '^devvm: agent_key_copy_failed agent=opencode vm=devvm-agents-[0-9a-f]{14}$'
rm $STUB_DIR/shell-fails-on

# pi's key, in a VM with pi: the store keeps it in pi's auth.json, the
# VM's copy holds its placeholder, the proxy binds it for Anthropic's API,
# and no import runs. Every launch sends the copy, never the key.
project pi
exec devvm --network open --no-git-protect --agents pi
vm_name PI pi
stdin $WORK/key2
! exec devvm agent login opencode --api-key --provider anthropic --stdin
stderr '^devvm: agent_login_no_agent agent=opencode vm=devvm-pi-[0-9a-f]{14}$'
stub_reset
stdin $WORK/key2
exec devvm agent login pi --api-key --provider anthropic --stdin
stdout '^==> agent_key_saved agent=pi provider=anthropic vm=devvm-pi-[0-9a-f]{14}$'
grep '"type": "api_key"' $DATA/logins/pi/.pi/agent/auth.json
grep '"key": "sk-ant-testfake"' $DATA/logins/pi/.pi/agent/auth.json
[!darwin] exec sh -c 'stat -c %a "$DATA/logins/pi/.pi/agent/auth.json"'
[darwin] exec sh -c 'stat -f %Lp "$DATA/logins/pi/.pi/agent/auth.json"'
stdout '^600$'
grep '"name":"pi-anthropic".*"hosts":\["api.anthropic.com"\]' $PI_dir/run/secrets.json
stub_calls
stdout '''sh'' ''-c'' ''f="\$HOME/\$1".*'' ''sh'' ''.pi/agent/auth.json''$'
! stdout 'opencode\.sh'
! stdout 'sk-ant-testfake'
stub_reset
exec devvm host
exec tar -xOf $STUB_DIR/sync.tar home/.pi/agent/auth.json
stdout '"key": "devvm-proxy-managed-pi-anthropic-[0-9a-f]{32}"'
! stdout testfake
cd $WORK/agents

# The VM's copy can't be written: the key is saved, and devvm says so.
exec sh -c 'echo "''.codex/auth.json''" > "$STUB_DIR/shell-fails-on"'
stdin $WORK/key
! exec devvm agent login codex --api-key --stdin
stderr '^devvm: agent_key_copy_failed agent=codex vm=devvm-agents-[0-9a-f]{14}$'
rm $STUB_DIR/shell-fails-on

# Without a terminal, devvm can't ask for the key, and names --stdin.
! exec devvm agent login codex --api-key
stderr '^agent_key_prompt\ndevvm: no_input answer=--stdin$'

# A login the VM's proxy saves while it runs: devvm names the account.
# Meanwhile another login finds localhost:1455 taken, and is refused.
exec sh -c 'printf cli_auth_credentials_store > "$STUB_DIR/shell-waits-on"'
exec devvm agent login codex &l&
wait_file $STUB_DIR/waiting
! exec devvm agent login codex
stderr '^devvm: agent_login_port_taken agent=codex port=1455$'
cp $WORK/chatgpt.json $DATA/logins/codex/.codex/auth.json
rm $STUB_DIR/shell-waits-on
wait l
stdout '^==> agent_login_saved_for agent=codex email=t@devvm\.test vm=devvm-agents-[0-9a-f]{14}$'
! exec nc -z 127.0.0.1 1455

# Interrupted: the forward goes, and so does the agent's login in the VM.
exec sh -c 'printf cli_auth_credentials_store > "$STUB_DIR/shell-waits-on"'
rm $STUB_DIR/waiting
stub_reset
! exec devvm agent login codex &i&
wait_file $STUB_DIR/waiting
kill -INT i
wait i
rm $STUB_DIR/shell-waits-on
! exec nc -z 127.0.0.1 1455
stub_calls
stdout 'devvm-login\.pid"; p=\$\(cat "\$f" 2>/dev/null\) && kill "\$p"'

# An empty key is refused.
stdin $WORK/empty
! exec devvm agent login codex --api-key --stdin
stderr '^devvm: agent_key_empty$'

# Claude Code: its login runs in the VM without the VM's token, nothing
# forwarded; the stub saves nothing, so devvm says so.
project claude
exec devvm --network open --no-git-protect --agents claude
vm_name CL claude
stub_reset
! exec devvm agent login claude
stdout '^==> agent_login_claude_paste$'
! stdout agent_login_forward
stderr '^devvm: agent_login_not_saved agent=claude vm=devvm-claude-[0-9a-f]{14}$'
stub_calls
stdout '''devvm'' ''env'' ''-u'' ''CLAUDE_CODE_OAUTH_TOKEN'' ''claude'' ''auth'' ''login'' ''--claudeai''$'
! stdout ssh

# A login the VM's proxy saves while it runs: the VM is set up again, and
# gets the OAuth login's copy with placeholders, and no token.
exec sh -c 'printf claudeai > "$STUB_DIR/shell-waits-on"'
rm $STUB_DIR/waiting
exec devvm agent login claude &c&
wait_file $STUB_DIR/waiting
mkdir $DATA/logins/claude/.claude
cp $WORK/credentials.json $DATA/logins/claude/.claude/.credentials.json
rm $STUB_DIR/shell-waits-on
wait c
stdout '^==> claude_login_saved vm=devvm-claude-[0-9a-f]{14}$'
# Only the launch, before the login, found none.
stderr -count=1 no_claude_token
exec tar -xOf $STUB_DIR/sync.tar home/.claude/.credentials.json
stdout '"accessToken": "sk-ant-oat01-devvm-proxy-managed-oauth-[0-9a-f]{32}"'
stdout '"refreshToken": "devvm-proxy-managed"'
! stdout testfake
exec tar -xOf $STUB_DIR/sync.tar env
! stdout CLAUDE_CODE_OAUTH_TOKEN

# claude setup-token: its token, saved while it runs, replaces the OAuth
# login, and the VM gets it as a placeholder in its environment instead.
exec sh -c 'printf setup-token > "$STUB_DIR/shell-waits-on"'
rm $STUB_DIR/waiting
exec devvm agent login claude --setup-token &s&
wait_file $STUB_DIR/waiting
stdin $WORK/claude.token
exec devvm secret set claude --stdin
! exists $DATA/logins/claude/.claude/.credentials.json
rm $STUB_DIR/shell-waits-on
wait s
stdout '^==> claude_setup_token_saved vm=devvm-claude-[0-9a-f]{14}$'
exec tar -tf $STUB_DIR/sync.tar
! stdout credentials
exec tar -xOf $STUB_DIR/sync.tar env
stdout '^export CLAUDE_CODE_OAUTH_TOKEN=''sk-ant-oat01-devvm-proxy-managed-[0-9a-f]{32}''$'

# A token in devvm's environment wins over the login, and devvm says so.
exec sh -c 'printf setup-token > "$STUB_DIR/shell-waits-on"'
rm $STUB_DIR/waiting
env CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-testfake-env
exec devvm agent login claude --setup-token &e&
wait_file $STUB_DIR/waiting
stdin $WORK/claude2.token
exec devvm secret set claude --stdin
rm $STUB_DIR/shell-waits-on
wait e
stdout '^==> claude_setup_token_saved'
stderr 'claude_env_token_wins'
env CLAUDE_CODE_OAUTH_TOKEN=

-- claude.token --
sk-ant-oat01-testfake-setup
-- claude2.token --
sk-ant-oat01-testfake-setup2
-- credentials.json --
{"claudeAiOauth": {"accessToken": "sk-ant-oat01-testfake", "refreshToken": "sk-ant-ort01-testfake", "expiresAt": 4070908800000, "scopes": ["user:inference"]}}

-- key --
sk-testfake-codex
-- key2 --
sk-ant-testfake
-- chatgpt.json --
{"tokens": {"id_token": "e30.eyJlbWFpbCI6InRAZGV2dm0udGVzdCJ9.sig", "access_token": "e30.e30.sig", "refresh_token": "rt"}}
-- empty --

