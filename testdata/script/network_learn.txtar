    },
    {
      "rule": "example.com:443",
      "host": "example.com",
      "port": 443,
      "count": 2,
      "last": "2099-01-01T00:00:02Z",
      "agent": "curl/8.5.0"
    },
    {
      "rule": "new.test:8080",
      "host": "new.test",
      "port": 8080,
      "count": 1,
      "last": "2099-01-01T00:00:03Z"
    },
    {
      "rule": "objects.github.com:443",
      "host": "objects.github.com",
      "port": 443,
      "count": 1,
      "last": "2099-01-01T00:00:09Z"
    },
    {
      "rule": "93.184.215.14:443",
      "host": "93.184.215.14",
      "port": 443,
      "count": 1,
      "last": "2099-01-01T00:00:05Z",
      "risk": "address"
    },
    {
      "rule": "pastebin.com:443",
      "host": "pastebin.com",
      "port": 443,
      "count": 1,
      "last": "2099-01-01T00:00:04Z",
