# scripts/publish.sh: the checks, --dry-run, the question, and each step,
# against a throwaway repo whose origin is a local bare repo, a local bare
# tap, a gh that keeps its release in $WORK/gh, SSH-signed tags, a
# minisign key without a password and a goreleaser that writes a small
# dist/. Pushes and gh's calls go in $WORK/calls, in order.
# The system's commands, not the stubs (ssh-keygen's): git signs with
# ssh-keygen. minisign is linked in from PATH first.
[!exec:git] skip
[!exec:minisign] skip
exec bash -c 'ln -s "$(command -v minisign)" bin/minisign'
env GIT_CONFIG_NOSYSTEM=1
env PATH=$WORK/bin:/usr/bin:/bin
chmod 755 bin/goreleaser
chmod 755 bin/gh
exec bash repo.sh
env DEVVM_TAP_DIR=$WORK/tap
env DEVVM_MINISIGN_KEY=$WORK/keys/release.key

# --help: the script's header.
exec repo/scripts/publish.sh --help
stdout '^  scripts/publish.sh --dry-run '
! exec repo/scripts/publish.sh --publish
stderr '^publish: unknown argument ''--publish''$'

# No tag yet: refused, by release.sh's check.
! exec repo/scripts/publish.sh --dry-run
stderr '^release: no tag v1.2.3: tag the release first'

# A tag by a key git trusts but packaging/release-signer doesn't pin:
# refused.
exec bash tag.sh other
! exec repo/scripts/publish.sh --dry-run
stderr '^release: tag v1.2.3 is signed by SHA256:\S+, not a key in packaging/release-signer$'
exec bash tag.sh good

# A working tree that isn't clean: refused.
exec touch repo/stray
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: the working tree isn''t clean'
rm repo/stray

# A release that's already on GitHub, without this release's files:
# refused.
mkdir gh/release
exec touch gh/release/notes.txt
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: devvm v1.2.3 already has a GitHub release, without devvm-1.2.3-darwin-arm64.tar.gz'
rm gh/release

# gh not logged in: refused.
exec touch gh/no-auth
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: gh isn''t logged in to GitHub: run gh auth login$'
rm gh/no-auth

# No tap checkout: refused.
env DEVVM_TAP_DIR=$WORK/nowhere
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: no tap checkout at '
env DEVVM_TAP_DIR=$WORK/tap

# None of those built anything.
! exists log

# --dry-run: everything it would publish, then nothing published: no
# push, no release, no tap commit.
rm calls
exec repo/scripts/publish.sh --dry-run
stdout '^Version: 1\.2\.3$'
stdout '^Tag:     v1\.2\.3, signed, at commit [0-9a-f]{40}$'
stdout '^  devvm-1\.2\.3-linux-amd64\.tar\.gz +[0-9]+ bytes  [0-9a-f]{64}$'
stdout '^  SHA256SUMS\.minisig +[0-9]+ bytes  [0-9a-f]{64}$'
stdout '^  - \*\*New:\*\* a thing\.$'
! stdout 'Older'
stdout '^\+      url "https://github.com/devvmhq/devvm/releases/download/v1\.2\.3/devvm-1\.2\.3-darwin-arm64\.tar\.gz"$'
stdout '^Formula/devvm\.rb:$'
stdout '^Formula/devvm-rc\.rb, which the tap doesn''t have yet, for this release too:$'
stdout '^\+class DevvmRc < Formula$'
stdout '^  1\. git push origin main: to do$'
stdout '^  4\. the tap''s commit, devvm 1\.2\.3, and git push: to do$'
stdout '^--dry-run: nothing published\.$'
cmp calls calls.view
exec bash refs.sh
cmp stdout refs.before
exists repo/dist/SHA256SUMS.minisig

# Answering n: nothing published.
rm calls
ttyin -stdin no.txt
! exec repo/scripts/publish.sh
ttyout 'Publish devvm 1\.2\.3\? \[y/N\] '
stderr '^publish: nothing published$'
cmp calls calls.view
exec bash refs.sh
cmp stdout refs.before

# Answering y, with gh failing to make the release: main and the tag are
# pushed, in that order, and the rest is said to be left.
rm calls
exec touch gh/fail-create
ttyin -stdin yes.txt
! exec repo/scripts/publish.sh
stderr '^publish: the GitHub release v1\.2\.3 failed\.$'
stderr '^  published: main on origin$'
stderr '^  published: the tag v1\.2\.3 on origin$'
stderr '^  not published: the GitHub release v1\.2\.3$'
stderr '^  not published: the tap''s Formula/devvm\.rb and Formula/devvm-rc\.rb$'
! exists gh/release

# Run again, with gh failing to publish the draft: it skips the pushes and
# leaves a draft with every file, never published.
rm gh/fail-create
exec touch gh/fail-edit
ttyin -stdin yes.txt
! exec repo/scripts/publish.sh
stdout '^origin''s main is already at [0-9a-f]{12}$'
stdout '^origin already has v1\.2\.3$'
stderr '^  not published: the GitHub release v1\.2\.3$'
exists gh/draft
exists gh/release/SHA256SUMS.minisig

# And again: it uploads the draft's files again, publishes it, then commits
# the formulas to the tap, devvm's and devvm-rc's, and pushes it.
rm gh/fail-edit
ttyin -stdin yes.txt
exec repo/scripts/publish.sh
stdout '^  3\. the GitHub release v1\.2\.3: to do, the draft''s files replaced$'
stdout '^==> devvm 1\.2\.3 is published$'
stdout '^Check it with Homebrew, brew update && brew upgrade devvm \(or brew trust --formula devvmhq/tap/devvm, then brew install devvmhq/tap/devvm\), or the install script:$'
stdout '^  curl -fsSL https://github.com/devvmhq/devvm/releases/download/v1\.2\.3/install\.sh \| bash$'
cmp calls calls.want
exec bash refs.sh
cmp stdout refs.after
exec bash -c 'cd gh/release && LC_ALL=C ls'
cmp stdout assets.want
! exists gh/draft
cmp gh/notes notes.want
cmp tap/Formula/devvm.rb repo/dist/devvm.rb
cmp tap/Formula/devvm-rc.rb repo/dist/devvm-rc.rb
exec git -C tap.git log -1 --format=%s main
stdout '^devvm 1\.2\.3$'

# And once more: everything's done, so it asks nothing.
rm calls
exec repo/scripts/publish.sh
stdout '^devvm 1\.2\.3 is already published: nothing to do\.$'
stdout '^Formula/devvm-rc\.rb:\n  \(already this release''s\)$'
grep '^gh release download v1\.2\.3 ' calls
! grep 'push|create|edit' calls

# A prerelease, 1.3.0-rc.1: its GitHub release is marked as one, and its
# tap commit, devvm-rc 1.3.0-rc.1, moves only devvm-rc, so the formula
# devvm stays on 1.2.3. It needs the tap checkout too.
exec bash version.sh 1.3.0-rc.1 'A release candidate.' 'another thing'
rm gh/release
rm gh/notes
rm calls
env DEVVM_TAP_DIR=$WORK/nowhere
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: no tap checkout at '
env DEVVM_TAP_DIR=$WORK/tap
exec repo/scripts/publish.sh --dry-run
stdout '^Version: 1\.3\.0-rc\.1, a prerelease$'
stdout '^Formula/devvm\.rb: stays on the last release, as this is a prerelease\.$'
stdout '^Formula/devvm-rc\.rb:$'
stdout '^\+      url "https://github.com/devvmhq/devvm/releases/download/v1\.3\.0-rc\.1/devvm-1\.3\.0-rc\.1-darwin-arm64\.tar\.gz"$'
! stdout '^\+class'
stdout '^  3\. the GitHub prerelease v1\.3\.0-rc\.1: to do, marked as a prerelease$'
stdout '^  4\. the tap''s commit, devvm-rc 1\.3\.0-rc\.1, and git push: to do$'
stdout '^  - \*\*New:\*\* another thing\.$'
! stdout 'Released today'
! exists repo/dist/devvm.rb
rm calls
ttyin -stdin yes.txt
exec repo/scripts/publish.sh
stdout '^==> devvm 1\.3\.0-rc\.1 is published$'
stdout '^Check it with Homebrew, brew update && brew upgrade devvm-rc \(or brew trust --formula devvmhq/tap/devvm-rc, then brew install devvmhq/tap/devvm-rc\), or the install script:$'
cmp calls calls.pre
exists gh/prerelease
cmp gh/notes notes.pre
exec git -C tap.git log -1 --format=%s main
stdout '^devvm-rc 1\.3\.0-rc\.1$'
exec git -C tap.git show --name-only --format= main
cmp stdout rc.changed
cmp tap/Formula/devvm-rc.rb repo/dist/devvm-rc.rb
grep 'download/v1\.2\.3/' tap/Formula/devvm.rb

# Run again: everything's done.
rm calls
exec repo/scripts/publish.sh
stdout '^devvm 1\.3\.0-rc\.1 is already published: nothing to do\.$'
! grep 'push|create|edit' calls

# A published prerelease that GitHub doesn't mark as one: refused.
rm gh/prerelease
! exec repo/scripts/publish.sh --dry-run
stderr '^publish: devvm v1\.3\.0-rc\.1 is a prerelease, but its GitHub release isn''t marked as one'

# A release older than devvm-rc's prerelease, 1.2.4: devvm moves to it,
# and devvm-rc stays on 1.3.0-rc.1.
exec bash version.sh 1.2.4 'A fix.' 'a fix'
rm gh/release
rm gh/notes
exec repo/scripts/publish.sh --dry-run
stdout '^Formula/devvm\.rb:$'
stdout '^Formula/devvm-rc\.rb: stays at 1\.3\.0-rc\.1, which is newer than 1\.2\.4\.$'
stdout '^  4\. the tap''s commit, devvm 1\.2\.4, and git push: to do$'
rm calls
ttyin -stdin yes.txt
exec repo/scripts/publish.sh
stdout '^==> the tap''s Formula/devvm\.rb$'
exec git -C tap.git show --name-only --format= main
stdout '^Formula/devvm\.rb\n\z'
grep 'download/v1\.3\.0-rc\.1/' tap/Formula/devvm-rc.rb

# A prerelease older than devvm-rc's, 1.2.5-rc.1: nothing in the tap
# changes, so there's no tap step.
exec bash version.sh 1.2.5-rc.1 'An older candidate.' 'an older thing'
rm gh/release
rm gh/notes
exec repo/scripts/publish.sh --dry-run
stdout '^Formula/devvm-rc\.rb: stays at 1\.3\.0-rc\.1, which is newer than 1\.2\.5-rc\.1\.$'
stdout '^  4\. the tap: nothing to change$'
rm calls
ttyin -stdin yes.txt
exec repo/scripts/publish.sh
stdout '^Check it with the install script, or devvm upgrade --to 1\.2\.5-rc\.1:$'
! grep 'push tap' calls

# The release 1.3.0, newer than devvm-rc's prerelease: devvm-rc moves to
# it with devvm, in one commit.
exec bash version.sh 1.3.0 'The release.' 'the release'
rm gh/release
rm gh/notes
rm gh/prerelease
exec repo/scripts/publish.sh --dry-run
stdout '^Formula/devvm-rc\.rb, which moves from 1\.3\.0-rc\.1 to this release too:$'
stdout '^\+      url "https://github.com/devvmhq/devvm/releases/download/v1\.3\.0/devvm-1\.3\.0-darwin-arm64\.tar\.gz"$'
rm calls
ttyin -stdin yes.txt
exec repo/scripts/publish.sh
exec git -C tap.git log -1 --format=%s main
stdout '^devvm 1\.3\.0$'
exec git -C tap.git show --name-only --format= main
cmp stdout both.changed
cmp tap/Formula/devvm.rb repo/dist/devvm.rb
cmp tap/Formula/devvm-rc.rb repo/dist/devvm-rc.rb
rm calls
exec repo/scripts/publish.sh
stdout '^devvm 1\.3\.0 is already published: nothing to do\.$'
! grep 'push|create|edit' calls

-- rc.changed --
Formula/devvm-rc.rb
-- both.changed --
Formula/devvm-rc.rb
Formula/devvm.rb
-- calls.pre --
gh auth status
gh release view v1.3.0-rc.1 --repo devvmhq/devvm --json isDraft,isPrerelease,assets --jq (.isDraft | tostring), (.isPrerelease | tostring), .assets[].name
push origin.git refs/heads/main
push origin.git refs/tags/v1.3.0-rc.1
gh release create v1.3.0-rc.1 --repo devvmhq/devvm --title devvm 1.3.0-rc.1 --notes-file notes.md --verify-tag --draft --prerelease devvm-1.3.0-rc.1-darwin-arm64.tar.gz devvm-1.3.0-rc.1-darwin-amd64.tar.gz devvm-1.3.0-rc.1-linux-arm64.tar.gz devvm-1.3.0-rc.1-linux-amd64.tar.gz devvm-1.3.0-rc.1.tar.gz SHA256SUMS SHA256SUMS.minisig install.sh
gh release edit v1.3.0-rc.1 --repo devvmhq/devvm --title devvm 1.3.0-rc.1 --notes-file notes.md --draft=false --prerelease
push tap.git refs/heads/main
