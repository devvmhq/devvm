-- repo.sh --
# The repo (VERSION 1.2.3, a changelog, release.sh and publish.sh), its
# origin one commit behind, two SSH keys git trusts (good, which
# packaging/release-signer pins, and other), the release key, and the tap.
set -eu
mkdir -p repo/scripts repo/packaging/homebrew keys gh
cp "$DEVVM_REPO/scripts/release.sh" "$DEVVM_REPO/scripts/publish.sh" repo/scripts/
cp "$DEVVM_REPO/packaging/homebrew/devvm.rb" repo/packaging/homebrew/
echo 1.2.3 > repo/VERSION
echo dist/ > repo/.gitignore
printf '#!/bin/sh\nrelease_version=""\nminisign_key=""\n' > repo/install.sh
printf '# Changelog\n\n## 1.2.3\n\nReleased today.\n\n- **New:** a thing.\n\n## 1.2.2\n\nOlder.\n' > repo/CHANGELOG.md
for n in good other; do ssh-keygen -q -t ed25519 -N '' -C "$n" -f "keys/$n"; done
{ printf 'e@e %s\n' "$(cat keys/good.pub)"; printf 'e@e %s\n' "$(cat keys/other.pub)"; } > keys/allowed
printf '# the release signer\n%s\n' "$(ssh-keygen -lf keys/good.pub | awk '{ print $2 }')" > repo/packaging/release-signer
minisign -G -W -p repo/packaging/minisign.pub -s keys/release.key >/dev/null
git config --global user.email e@e
git config --global user.name e
git config --global gpg.format ssh
git config --global gpg.ssh.allowedSignersFile "$PWD/keys/allowed"
git config --global init.defaultBranch main
for r in origin tap; do
  git init -q --bare "$r.git"
  printf '#!/bin/sh\nwhile read -r o n r; do echo "push %s $r" >> "$WORK/calls"; done\n' "$r.git" > "$r.git/hooks/post-receive"
  chmod 755 "$r.git/hooks/post-receive"
done
git init -q repo
git -C repo add -A
git -C repo commit -qm r
git -C repo remote add origin "$PWD/origin.git"
git -C repo push -q origin main
echo more > repo/more
git -C repo add more
git -C repo commit -qm 'release 1.2.3'
git init -q tap
echo tap > tap/README
git -C tap add -A
git -C tap commit -qm tap
git -C tap remote add origin "$PWD/tap.git"
git -C tap push -q origin main
rm -f calls
-- tag.sh --
# Tag $2, v1.2.3 without it, (again), signed with key $1.
set -eu
t=${2:-v1.2.3}
git -C repo tag -d "$t" >/dev/null 2>&1 || true
git -C repo -c user.signingkey="$PWD/keys/$1" tag -s "$t" -m "$t"
-- version.sh --
# VERSION $1 and its changelog entry, $2 then a list item New: $3, over
# 1.2.3's, committed on main and tagged.
set -eu
echo "$1" > repo/VERSION
printf '# Changelog\n\n## %s\n\n%s\n\n- **New:** %s.\n\n## 1.2.3\n\nReleased today.\n' "$1" "$2" "$3" > repo/CHANGELOG.md
git -C repo commit -qam "release $1"
bash tag.sh good "v$1"
-- refs.sh --
# What origin and the tap hold: main's commit message, the tag, the tap's
# last commit, and whether it has the formula.
git -C origin.git log -1 --format=%s main
git -C origin.git tag -l
git -C tap.git log -1 --format=%s main
f=$(git -C tap.git ls-tree --name-only main Formula/ | paste -sd' ' -)
echo "formulas: ${f:-none}"
