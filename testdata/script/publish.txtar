-- bin/gh --
#!/bin/bash
# A gh that logs each call to $WORK/calls (paths as their base names) and
# keeps one release in $WORK/gh: release/ its files, draft while it's a
# draft, prerelease once it's marked as one, notes its notes. Switches:
# gh/no-auth fails gh auth status,
# gh/fail-create gh release create, gh/fail-edit gh release edit.
set -eu
s=$WORK/gh
line=gh
for a in "$@"; do
  [[ $a != /* && $a != dist/* ]] || a=${a##*/}
  line+=" $a"
done
echo "$line" >> "$WORK/calls"
# files ARG…: what's left after the subcommand's options, copied into the
# release; the notes and the draft as they say.
files() {
  while (($#)); do
    case $1 in
      --notes-file) cp "$2" "$s/notes"; shift 2 ;;
      --repo | --title | --pattern | --dir | --json | --jq) shift 2 ;;
      --draft) touch "$s/draft"; shift ;;
      --draft=false) rm -f "$s/draft"; shift ;;
      --prerelease) touch "$s/prerelease"; shift ;;
      --*) shift ;;
      *) cp "$1" "$s/release/"; shift ;;
    esac
  done
}
case "$1 $2" in
  "auth status") [[ ! -e $s/no-auth ]] ;;
  "release view")
    [[ -d $s/release ]] || { echo "release not found" >&2; exit 1; }
    if [[ -e $s/draft ]]; then echo true; else echo false; fi
    if [[ -e $s/prerelease ]]; then echo true; else echo false; fi
    ls "$s/release" ;;
  "release create")
    [[ ! -e $s/fail-create ]] || { echo "HTTP 502: Bad Gateway" >&2; exit 1; }
    git --git-dir="$WORK/origin.git" rev-parse -q --verify "refs/tags/$3" >/dev/null || { echo "tag $3 doesn't exist in the repo" >&2; exit 1; }
    [[ ! -d $s/release ]] || { echo "a release with the same tag name already exists: $3" >&2; exit 1; }
    mkdir "$s/release"
    shift 3; files "$@" ;;
  "release upload" | "release edit")
    [[ -d $s/release ]] || { echo "release not found" >&2; exit 1; }
    [[ $2 != edit || ! -e $s/fail-edit ]] || { echo "HTTP 502: Bad Gateway" >&2; exit 1; }
    shift 3; files "$@" ;;
  "release download")
    dir=
    while (($#)); do [[ $1 == --dir ]] && dir=$2; shift; done
    mkdir -p "$dir"
    cp "$s/release/SHA256SUMS" "$dir/" ;;
  *) echo "gh: no fake for $*" >&2; exit 1 ;;
esac
-- bin/goreleaser --
#!/bin/bash
# Logs its call and writes a dist/ like GoReleaser's, the same each time:
# each system's and processor's build, a script printing $DEVVM_VERSION, an
# archive for each (a line of text), the source tarball and SHA256SUMS.
set -eu
echo "$*" >> "$WORK/log"
rm -rf dist
mkdir dist
for os in darwin linux; do
  for a in arm64 amd64; do
    mkdir -p "dist/devvm_${os}_$a"
    printf '#!/bin/sh\necho %s\n' "$DEVVM_VERSION" > "dist/devvm_${os}_$a/devvm"
    chmod 755 "dist/devvm_${os}_$a/devvm"
    echo "devvm $DEVVM_VERSION $os $a" > "dist/devvm-$DEVVM_VERSION-$os-$a.tar.gz"
  done
done
git archive --prefix="devvm-$DEVVM_VERSION/" HEAD | gzip -n > "dist/devvm-$DEVVM_VERSION.tar.gz"
(cd dist && { sha256sum devvm-*.tar.gz 2>/dev/null || shasum -a 256 devvm-*.tar.gz; } > SHA256SUMS)
